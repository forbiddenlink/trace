# Google Gemini Configuration (Required)
# Server-side only — never prefix with VITE_. Used by /api/generate.
# This is the only key Trace needs. Grounding is done with an in-prompt catalog,
# so there is no search service to configure.
GOOGLE_GENERATIVE_AI_API_KEY=
VITE_SENTRY_DSN=

# Durable rate limiting for /api/generate (Upstash Redis REST); optional GLOBAL_RATE_LIMIT_MAX
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GLOBAL_RATE_LIMIT_MAX=
